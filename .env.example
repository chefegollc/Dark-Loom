# Dark-Loom Environment Variables

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Configuration
DARK_LOOM_DEFAULT_MODEL=claude-3-5-sonnet-20241022
DARK_LOOM_TEMPERATURE=0.7
DARK_LOOM_MAX_TOKENS=4096
DARK_LOOM_LOG_LEVEL=INFO
DARK_LOOM_DEBUG=false

# Weaver Configuration
DARK_LOOM_MAX_ITERATIONS=10
DARK_LOOM_TIMEOUT=300
